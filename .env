# ═══════════════════════════════════════════════════════════════
#  CyberVault — Environment Configuration
#  Copy this file to .env and fill in your real credentials.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Flask ────────────────────────────────────────────────────────
FLASK_SECRET_KEY=evidence-lot-secret-2024-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# ── SQLite (local fallback / development) ────────────────────────
# Path is relative to the project root. Leave as-is for default.
SQLITE_DB_PATH=cybervault.db

# ── Supabase (cloud PostgreSQL) ──────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
#
# 1. Project URL  (looks like: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
#
# 2. Anon / public key  (safe to use in server-side code)
SUPABASE_ANON_KEY=your-anon-public-key-here
#
# 3. Service role key  (full DB access — keep SECRET, never expose)
SUPABASE_SERVICE_KEY=your-service-role-key-here
#
# 4. Direct PostgreSQL connection string (for SQLAlchemy / psycopg2)
#    Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres
#    Get from: Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ── Database mode ────────────────────────────────────────────────
# "sqlite"    → use local SQLite only
# "supabase"  → use Supabase PostgreSQL only
# "dual"      → write to both; read from Supabase, fallback to SQLite
DB_MODE=dual
