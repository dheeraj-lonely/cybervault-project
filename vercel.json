{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["templates/**", "static/**"] }
    }
  ],
  "routes": [
    { "src": "/static/(.*)",  "dest": "/static/$1" },
    { "src": "/api/(.*)",     "dest": "/app.py"    },
    { "src": "/game",         "dest": "/app.py"    },
    { "src": "/",             "dest": "/app.py"    },
    { "src": "/(.*)",         "dest": "/app.py"    }
  ]
}
